APP_DOMAIN=chat.example.com
RTC_DOMAIN=rtc.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# URL-encode reserved characters in the password below.
DATABASE_URL=postgres://wiisb:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/wiisb
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
LIVEKIT_API_KEY=REPLACE_WITH_RANDOM_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Email for "forgot password" (any SMTP provider: Brevo, Mailgun, SES, Gmail app password, ...).
# Without SMTP_HOST and MAIL_FROM, email recovery is switched off and the app hides it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=WIISB Chat <no-reply@chat.example.com>
ADMIN_USER_IDS=
MAX_UPLOAD_MB=64
USER_STORAGE_MB=2048
