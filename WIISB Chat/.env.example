# Copy to .env. npm scripts run with apps/server as cwd, so use absolute DATA_DIR
# or start with scripts/Start-LocalServer.ps1, which loads the root .env.
HOST=127.0.0.1
PORT=4310
DATA_DIR=E:/Development/Physical App Development/WIISB Chat/.data
# Leave DATABASE_URL empty for durable embedded PostgreSQL (development only).
DATABASE_URL=
# Set a random 48+ character value for stable access tokens across restarts.
JWT_SECRET=
CORS_ORIGINS=http://localhost:1432,http://127.0.0.1:1432,http://tauri.localhost,tauri://localhost
MAX_UPLOAD_MB=64
USER_STORAGE_MB=2048
STORAGE_ADAPTER=local
# Optional private S3-compatible storage; the server proxies authorized downloads.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local LiveKit only; these development credentials are never for public hosting.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Outgoing email, used for "forgot password". Leave SMTP_HOST empty to turn it off.
# In development with no SMTP, the emails (with their codes) are printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be an address your SMTP provider lets you send from, e.g. WIISB Chat <no-reply@example.com>
MAIL_FROM=
# Explicit platform-admin user UUIDs. No user is automatically an admin.
ADMIN_USER_IDS=
TRUST_PROXY=false
